{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rdso-drawings.local/schema/edge.schema.json",
  "title": "RDSO Knowledge Graph Relationship",
  "type": "object",
  "required": ["from", "to", "rel"],
  "properties": {
    "from": { "type": "string", "minLength": 1 },
    "to": { "type": "string", "minLength": 1 },
    "rel": { "type": "string", "minLength": 1, "pattern": "^[A-Z][A-Z0-9_]*$" },
    "rationale": { "type": "string" },
    "evidence_ids": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "verification_status": { "type": "string", "enum": ["unverified", "machine_extracted", "reviewed", "verified", "disputed"] },
    "source": { "type": ["string", "null"] },
    "derived_from": { "type": "array", "items": { "type": "string" }, "uniqueItems": true }
  },
  "additionalProperties": true
}
