{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rdso-drawings.local/schema/entity.schema.json",
  "title": "RDSO Knowledge Graph Entity",
  "type": "object",
  "required": ["id", "type", "name"],
  "properties": {
    "id": { "type": "string", "minLength": 1, "pattern": "^[A-Za-z0-9:_./-]+$" },
    "type": { "type": "string", "minLength": 1 },
    "name": { "type": "string", "minLength": 1 },
    "description": { "type": "string" },
    "aliases": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
    "status": { "type": "string", "enum": ["active", "superseded", "deprecated", "draft", "unknown"] },
    "document_id": { "type": "string" },
    "source_file_id": { "type": "string" },
    "evidence_ids": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "verification_status": { "type": "string", "enum": ["unverified", "machine_extracted", "reviewed", "verified", "disputed"] },
    "properties": { "type": "object" }
  },
  "additionalProperties": true
}
