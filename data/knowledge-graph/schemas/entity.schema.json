{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rdso-drawings.local/schema/entity.schema.json",
  "title": "RDSO Knowledge Graph Entity",
  "type": "object",
  "required": ["id", "type"],
  "anyOf": [
    { "required": ["name"] },
    { "required": ["label"] }
  ],
  "properties": {
    "id": { "type": "string", "minLength": 1 },
    "type": { "type": "string", "minLength": 1 },
    "name": { "type": "string", "minLength": 1 },
    "label": { "type": "string", "minLength": 1 },
    "description": { "type": "string" },
    "desc": { "type": "string" },
    "aliases": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
    "status": { "type": "string" },
    "canonical_status": { "type": "string" },
    "document_id": { "type": "string" },
    "source_file_id": { "type": "string" },
    "evidence_ids": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "verification_status": { "type": "string" },
    "properties": { "type": "object" },
    "specs": { "type": "object" },
    "domain": { "type": "string" }
  },
  "additionalProperties": true
}
