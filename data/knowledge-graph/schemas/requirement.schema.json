{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rdso-drawings.local/schema/requirement.schema.json",
  "title": "RDSO Knowledge Graph Requirement",
  "type": "object",
  "required": ["id", "statement"],
  "properties": {
    "id": { "type": "string", "minLength": 1 },
    "statement": { "type": "string", "minLength": 1 },
    "requirement_type": { "type": "string", "enum": ["design", "material", "geometry", "inspection", "maintenance", "safety", "procurement", "procedure", "performance", "other"] },
    "priority": { "type": "string", "enum": ["mandatory", "recommended", "informative", "unknown"] },
    "applies_to": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
    "measurement_ids": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
    "evidence_ids": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
    "source_document_id": { "type": "string" },
    "clause": { "type": "string" },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "verification_status": { "type": "string", "enum": ["unverified", "machine_extracted", "reviewed", "verified", "disputed"] }
  },
  "additionalProperties": true
}
