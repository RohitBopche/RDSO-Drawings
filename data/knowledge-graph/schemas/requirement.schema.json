{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rdso-drawings.local/schema/requirement.schema.json",
  "title": "RDSO Knowledge Graph Requirement",
  "type": "object",
  "required": ["id"],
  "anyOf": [
    { "required": ["statement"] },
    { "required": ["desc"] },
    { "required": ["label"] }
  ],
  "properties": {
    "id": { "type": "string", "minLength": 1 },
    "statement": { "type": "string", "minLength": 1 },
    "desc": { "type": "string" },
    "label": { "type": "string" },
    "type": { "type": "string" },
    "requirement_type": { "type": "string" },
    "priority": { "type": "string" },
    "applies_to": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
    "measurement_ids": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
    "evidence_ids": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
    "source_document_id": { "type": "string" },
    "clause": { "type": "string" },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "verification_status": { "type": "string" },
    "canonical_status": { "type": "string" },
    "specs": { "type": "object" },
    "domain": { "type": "string" }
  },
  "additionalProperties": true
}
