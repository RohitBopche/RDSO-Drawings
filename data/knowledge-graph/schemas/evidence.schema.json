{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rdso-drawings.local/schema/evidence.schema.json",
  "title": "RDSO Knowledge Graph Evidence",
  "type": "object",
  "required": ["evidence_id", "document_id", "extraction_method", "verification_status"],
  "properties": {
    "evidence_id": { "type": "string", "minLength": 1 },
    "document_id": { "type": "string", "minLength": 1 },
    "source_file_id": { "type": "string" },
    "page_id": { "type": "string" },
    "section": { "type": "string" },
    "clause": { "type": "string" },
    "quote": { "type": "string" },
    "region": {
      "type": "array",
      "prefixItems": [
        { "type": "number", "minimum": 0 },
        { "type": "number", "minimum": 0 },
        { "type": "number", "minimum": 0 },
        { "type": "number", "minimum": 0 }
      ],
      "items": false
    },
    "extraction_method": { "type": "string", "enum": ["manual", "text_extract", "ocr", "table_extract", "drawing_parse", "derived"] },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "verification_status": { "type": "string", "enum": ["unverified", "machine_extracted", "reviewed", "verified", "disputed"] },
    "verified_by": { "type": "string" },
    "verification_note": { "type": "string" }
  },
  "additionalProperties": true
}
